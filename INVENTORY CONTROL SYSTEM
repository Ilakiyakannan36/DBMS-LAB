/* ==========================================
   VIEW
   ========================================== */

CREATE VIEW MaterialStockView AS
SELECT
    MaterialID,
    MaterialName,
    StockQty,
    ReorderLevel
FROM Materials;

/* ==========================================
   STORED PROCEDURE
   ========================================== */

DELIMITER $$

CREATE PROCEDURE GetLowStockMaterials()
BEGIN
    SELECT *
    FROM Materials
    WHERE StockQty <= ReorderLevel;
END $$

DELIMITER ;

/* ==========================================
   FUNCTION
   ========================================== */

DELIMITER $$

CREATE FUNCTION CalculateStockValue(mid INT)
RETURNS DECIMAL(12,2)
DETERMINISTIC
BEGIN
    DECLARE totalValue DECIMAL(12,2);

    SELECT StockQty * UnitPrice
    INTO totalValue
    FROM Materials
    WHERE MaterialID = mid;

    RETURN totalValue;
END $$

DELIMITER ;

/* ==========================================
   TRIGGER
   ========================================== */

DELIMITER $$

CREATE TRIGGER UpdateStockAfterPurchase
AFTER INSERT ON PurchaseOrders
FOR EACH ROW
BEGIN
    UPDATE Materials
    SET StockQty = StockQty + NEW.OrderQty
    WHERE MaterialID = NEW.MaterialID;
END $$

DELIMITER ;

/* ==========================================
   QUERIES
   ========================================== */

-- 1. Display all materials
SELECT * FROM Materials;

-- 2. Display all suppliers
SELECT * FROM Suppliers;

-- 3. Materials with supplier details
SELECT m.MaterialName,
       m.StockQty,
       s.SupplierName
FROM Materials m
JOIN Suppliers s
ON m.SupplierID = s.SupplierID;

-- 4. Low stock materials
SELECT *
FROM Materials
WHERE StockQty <= ReorderLevel;

-- 5. Purchase orders
SELECT * FROM PurchaseOrders;

-- 6. Inventory transactions
SELECT * FROM InventoryTransactions;

-- 7. Total stock value
SELECT MaterialName,
       StockQty,
       UnitPrice,
       StockQty * UnitPrice AS TotalValue
FROM Materials;

-- 8. Use Function
SELECT CalculateStockValue(1);

-- 9. Use Procedure
CALL GetLowStockMaterials();

-- 10. Use View
SELECT * FROM MaterialStockView;
