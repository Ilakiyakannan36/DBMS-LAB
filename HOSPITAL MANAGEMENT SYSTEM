/* ==========================================
   VIEW
   ========================================== */

CREATE VIEW PatientAppointmentView AS
SELECT
    p.PatientID,
    p.PatientName,
    d.DoctorName,
    d.Specialization,
    a.AppointmentDate,
    a.Status
FROM Patients p
JOIN Appointments a
ON p.PatientID = a.PatientID
JOIN Doctors d
ON d.DoctorID = a.DoctorID;

/* ==========================================
   STORED PROCEDURE
   ========================================== */

DELIMITER $$

CREATE PROCEDURE GetAppointmentsByDoctor(IN docid INT)
BEGIN
    SELECT
        a.AppointmentID,
        p.PatientName,
        a.AppointmentDate,
        a.AppointmentTime
    FROM Appointments a
    JOIN Patients p
    ON a.PatientID = p.PatientID
    WHERE a.DoctorID = docid;
END $$

DELIMITER ;

/* ==========================================
   FUNCTION
   ========================================== */

DELIMITER $$

CREATE FUNCTION GetPatientBill(pid INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    DECLARE totalBill DECIMAL(10,2);

    SELECT SUM(Amount)
    INTO totalBill
    FROM Bills
    WHERE PatientID = pid;

    RETURN IFNULL(totalBill,0);
END $$

DELIMITER ;

/* ==========================================
   TRIGGER
   ========================================== */

DELIMITER $$

CREATE TRIGGER CheckBillAmount
BEFORE INSERT ON Bills
FOR EACH ROW
BEGIN
    IF NEW.Amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Bill amount must be greater than zero';
    END IF;
END $$

DELIMITER ;

/* ==========================================
   QUERIES
   ========================================== */

-- 1. Display all doctors
SELECT * FROM Doctors;

-- 2. Display all patients
SELECT * FROM Patients;

-- 3. Display appointments
SELECT * FROM Appointments;

-- 4. Display bills
SELECT * FROM Bills;

-- 5. Patients with doctor details
SELECT p.PatientName,
       d.DoctorName,
       d.Specialization
FROM Patients p
JOIN Appointments a
ON p.PatientID = a.PatientID
JOIN Doctors d
ON d.DoctorID = a.DoctorID;

-- 6. Paid bills
SELECT *
FROM Bills
WHERE PaymentStatus='Paid';

-- 7. Total bill amount per patient
SELECT PatientID,
       SUM(Amount) AS TotalAmount
FROM Bills
GROUP BY PatientID;

-- 8. Use Function
