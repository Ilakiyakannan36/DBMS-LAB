/* ==========================================
   VIEW
   ========================================== */

CREATE VIEW ReservationDetails AS
SELECT
    r.ReservationID,
    p.PassengerName,
    t.TrainName,
    r.JourneyDate,
    r.SeatNo,
    r.TicketStatus
FROM Reservations r
JOIN Passengers p
ON r.PassengerID = p.PassengerID
JOIN Trains t
ON r.TrainID = t.TrainID;

/* ==========================================
   STORED PROCEDURE
   ========================================== */

DELIMITER $$

CREATE PROCEDURE GetTrainPassengers(IN train_id INT)
BEGIN
    SELECT
        p.PassengerName,
        p.Age,
        r.SeatNo
    FROM Passengers p
    JOIN Reservations r
    ON p.PassengerID = r.PassengerID
    WHERE r.TrainID = train_id;
END $$

DELIMITER ;

/* ==========================================
   FUNCTION
   ========================================== */

DELIMITER $$

CREATE FUNCTION GetPaymentAmount(res_id INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    DECLARE amt DECIMAL(10,2);

    SELECT Amount
    INTO amt
    FROM Payments
    WHERE ReservationID = res_id;

    RETURN IFNULL(amt,0);
END $$

DELIMITER ;

/* ==========================================
   TRIGGER
   ========================================== */

DELIMITER $$

CREATE TRIGGER CheckPaymentAmount
BEFORE INSERT ON Payments
FOR EACH ROW
BEGIN
    IF NEW.Amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Payment amount must be greater than zero';
    END IF;
END $$

DELIMITER ;

